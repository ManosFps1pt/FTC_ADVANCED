# Create a Discord application and bot at https://discord.com/developers/applications.
# Keep this file as a template only. Never commit the real token.
DISCORD_BOT_TOKEN=

# Comma-separated server IDs that should receive instant command updates while
# testing, for example: 123456789012345678,234567890123456789.
# Omit it only when you intentionally want global commands (which can take time to appear).
FTC_DISCORD_GUILD_IDS=

# The Driver Station backend URL. Keep it loopback-only when the bot runs on the
# Driver Station laptop. Do not expose this backend directly to the public internet.
FTC_ADVANCED_API_BASE=http://127.0.0.1:8000

# Optional comma-separated Discord role IDs. With this empty, any member of the
# configured server can use the read-only commands. This is not a control permission.
FTC_DISCORD_VIEWER_ROLE_IDS=
